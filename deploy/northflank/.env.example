# Northflank environment variables, not local application credentials.
REMOTE_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
REMOTE_DATA_DIR=/data
PORT=8080

# All attempts (including errors) count; quotas reset at midnight UTC.
REMOTE_REQUESTS_PER_DAY=400
REMOTE_WORK_SECONDS_PER_DAY=3600
REMOTE_BATCH_SECONDS=180
REMOTE_BATCH_WORDS=10
REMOTE_MAX_PENDING_MB=128
REMOTE_POLL_SECONDS=60
